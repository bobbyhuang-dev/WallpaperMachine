    },
    "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved this software, and running it may put your data at risk. Only files matching this fingerprint are allowed, and the quarantine flag is removed from this copy only. Gatekeeper and signature checks stay on for everything else.\n\nPath: %@\nSHA-256: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准此软件，运行它可能危及你的数据。只允许与此指纹一致的文件，并且只移除这份副本的隔离标记。Gatekeeper 和签名检查对其他软件照常生效。\n\n路径：%1$@\nSHA-256：%2$@"}}}
    },
    "Discard downloaded SteamCMD?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Discard downloaded SteamCMD?"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "要丢弃下载的 SteamCMD 吗？"}}}
    },
