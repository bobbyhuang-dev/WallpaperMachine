    },
    "Steam will download the Windows version of Wallpaper Engine to a temporary folder. Only its shared assets are kept; Windows programs are never run. This can require several GB of temporary disk space." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam will download the Windows version of Wallpaper Engine to a temporary folder. Only its shared assets are kept; Windows programs are never run. This can require several GB of temporary disk space."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 会将 Windows 版 Wallpaper Engine 下载到临时文件夹。仅保留其中的共享资源，绝不运行 Windows 程序。此过程可能需要数 GB 的临时磁盘空间。"}}}
    },
    "Use an account that owns Wallpaper Engine. SteamCMD enforces access. This downloads one item; it does not subscribe or automatically apply it." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Use an account that owns Wallpaper Engine. SteamCMD enforces access. This downloads one item; it does not subscribe or automatically apply it."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请使用拥有 Wallpaper Engine 的账号。SteamCMD 会验证访问权限。此操作仅下载一个项目，不会订阅或自动应用。"}}}
    },
    "Steam account login name" : {
