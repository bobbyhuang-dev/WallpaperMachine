{
  "sourceLanguage" : "en",
  "strings" : {
    "Finished downloads" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Finished downloads"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已结束的下载"}}}
    },
    "The appearance could not update: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The appearance could not update: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "外观无法更新：%@"}}}
    },
    "The interface could not update: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The interface could not update: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "界面无法更新：%@"}}}
    },
    "This page is not allowed to control the application." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This page is not allowed to control the application."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此页面无权控制应用。"}}}
    },
    "The interface stopped unexpectedly. Close and reopen the control panel to retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The interface stopped unexpectedly. Close and reopen the control panel to retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "界面意外停止。请关闭并重新打开控制面板重试。"}}}
    },
    "Couldn’t load the interface" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t load the interface"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法加载界面"}}}
    },
    "Reload" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Reload"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "重新加载"}}}
    },
    "The control panel has closed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The control panel has closed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "控制面板已关闭。"}}}
    },
    "Assets folder not found" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Assets folder not found"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未找到资源文件夹"}}}
    },
    "Sign-in needed" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Sign-in needed"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "需要登录验证"}}}
    },
    "Clear finished downloads" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Clear finished downloads"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "清除已结束的任务"}}}
    },
    "Select a download" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Select a download"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择下载任务"}}}
    },
    "Choose a download to view progress, complete Steam Guard, or show it in Library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a download to view progress, complete Steam Guard, or show it in Library."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择下载任务以查看进度、完成 Steam 令牌验证，或在壁纸库中显示。"}}}
    },
    "Up to three downloads run at once, each in its own private SteamCMD session. Extra requests wait in the order added. Close details, search, or switch pages while downloads continue; Download Details keeps every item available for progress, Steam Guard, retry, and cancellation. Quit stops active and queued downloads." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Up to three downloads run at once, each in its own private SteamCMD session. Extra requests wait in the order added. Close details, search, or switch pages while downloads continue; Download Details keeps every item available for progress, Steam Guard, retry, and cancellation. Quit stops active and queued downloads."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "最多同时进行三个下载，每项使用独立的私有 SteamCMD 会话。其余请求按添加顺序排队。关闭详情、搜索或切换页面时下载仍会继续；“下载详情”可查看每项任务的进度、完成 Steam 令牌验证、重试或取消。退出应用会停止正在进行和排队的下载。"}}}
    },
    "MacWallpaperEngine runs private copies of SteamCMD and removes temporary download staging. Keep me signed in on this Mac saves Steam-issued sign-in cache in private app support storage, never submitted passwords or Steam Guard codes. Sign-in settings and Forget are locked while any downloads are active or queued. Once they finish, turn the setting off or choose Forget saved Steam sign-in to remove the local cache; other Steam devices stay signed in. Steam can request fresh authentication after expiry, revocation, or security checks. Downloads can take longer on first launch while SteamCMD updates." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "MacWallpaperEngine runs private copies of SteamCMD and removes temporary download staging. Keep me signed in on this Mac saves Steam-issued sign-in cache in private app support storage, never submitted passwords or Steam Guard codes. Sign-in settings and Forget are locked while any downloads are active or queued. Once they finish, turn the setting off or choose Forget saved Steam sign-in to remove the local cache; other Steam devices stay signed in. Steam can request fresh authentication after expiry, revocation, or security checks. Downloads can take longer on first launch while SteamCMD updates."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "MacWallpaperEngine 运行 SteamCMD 的私有副本，并清理临时下载目录。“在此 Mac 上保持登录”仅在私有应用支持目录保存 Steam 签发的登录缓存，不保存提交的密码或 Steam 令牌验证码。存在正在进行或排队的下载时，登录设置和忘记登录操作会锁定。任务结束后，可关闭该设置或选择“忘记已保存的 Steam 登录”移除本地缓存；其他 Steam 设备仍保持登录。缓存过期、撤销或安全检查后，Steam 可能要求重新验证。首次启动时 SteamCMD 更新可能使下载耗时更长。"}}}
    },
    "Reacts to sound playing in other apps, not the microphone. macOS asks for system audio recording access when an enabled wallpaper starts. Wallpaper volume and mute do not affect this input." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应其他应用播放的声音，而非麦克风。启用此功能的壁纸启动时，macOS 会请求系统音频录制权限。壁纸音量和静音不会影响此输入。"
          }
        }
      }
    },
    "Updating audio response…" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新音频响应…"
          }
        }
      }
    },
    "Downloads" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Queued" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队中"
          }
        }
      }
    },
    "Downloading" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载中"
          }
        }
      }
    },
    "Cancel queued download" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消排队下载"
          }
        }
      }
    },
    "%lld/%lld active · %lld queued" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 项正在下载 · %3$lld 项排队中"
          }
        }
      }
    },
    "Sign-in needed · %@" : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要登录 · %@"
          }
        }
      }
    },
    "Waiting for a free download slot. Queued downloads start in the order added." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待可用的下载名额。排队的下载将按添加顺序开始。"
          }
        }
      }
    },
    "Saved sign-in settings are locked until all active and queued downloads finish." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有正在进行和排队的下载结束前，已保存的登录设置将保持锁定。"
          }
        }
      }
    },
    "Use an account that owns Wallpaper Engine. SteamCMD enforces access. Downloads run in the background and do not subscribe or automatically apply wallpapers." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用拥有 Wallpaper Engine 的账号，SteamCMD 会验证访问权限。下载在后台进行，不会订阅或自动应用壁纸。"
          }
        }
      }
    },
    "Up to three downloads run at once, each in its own private SteamCMD session. Extra requests wait in the order added. Close details, search, or switch pages while downloads continue; Workshop’s Downloads panel keeps every item available for progress, Steam Guard, retry, and cancellation. Quit stops active and queued downloads." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可同时进行三个下载，每个下载使用独立的私有 SteamCMD 会话。其他请求按添加顺序排队。关闭详情、搜索或切换页面不会中断下载；创意工坊的“下载”面板可查看每个项目的进度、完成 Steam 令牌验证、重试或取消。退出应用会停止所有正在进行和排队的下载。"
          }
        }
      }
    },
    "You can close this view and keep browsing. Reopen this download from Workshop’s Downloads panel for Steam Guard. Downloads stop after 5 minutes without SteamCMD output or 30 minutes overall." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以关闭此窗口继续浏览。在创意工坊的“下载”面板中重新打开此项目以完成 Steam 令牌验证。SteamCMD 连续 5 分钟无输出或总耗时超过 30 分钟时，本次下载会停止。"
          }
        }
      }
    },
    "3. Choose a wallpaper, select steamcmd.sh, enter your Steam account login name, and confirm ownership on first use or when switching accounts. Enter your password or Steam Guard code only when prompted; mobile approval is supported." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 选择壁纸和 steamcmd.sh，输入 Steam 账号登录名，并在首次使用或切换账号时确认拥有 Wallpaper Engine。仅在出现提示时输入密码或 Steam 令牌验证码；也支持通过手机批准登录。"
          }
        }
      }
    },
    "MacWallpaperEngine removes temporary download staging. Keep me signed in on this Mac saves Steam-issued sign-in cache in private app support storage, never submitted passwords or Steam Guard codes. Sign-in settings and Forget are locked while any downloads are active or queued. Once they finish, turn the setting off or choose Forget saved Steam sign-in to remove the local cache; other Steam devices stay signed in. Steam can request fresh authentication after expiry, revocation, or security checks. Downloads can take longer on first launch while SteamCMD updates." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacWallpaperEngine 会清理临时下载目录。“在这台 Mac 上保持登录”会将 Steam 签发的登录缓存保存在私有的应用支持目录中，绝不保存输入的密码或 Steam 令牌验证码。有下载正在进行或排队时，登录设置和清除按钮会锁定。全部结束后，关闭此设置或选择“清除已保存的 Steam 登录”即可删除本地缓存；其他 Steam 设备仍保持登录。缓存过期、被撤销或触发安全检查时，Steam 可能要求重新验证。首次启动时 SteamCMD 需要更新，下载可能耗时更长。"
          }
        }
      }
    },
    "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未能完成 SteamCMD 安全评估。请解决系统安全评估错误后重试；显式授权不能绕过评估过程的故障。"}}}
    },
    "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准位于 %@ 的 SteamCMD。请核对并仅允许这份副本，或按 Apple 安全指引操作后重试。系统安全设置未被修改。"}}}
    },
    "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 候选文件或私有授权记录已改变或不安全。请重新核对当前副本；本次未保存授权。"}}}
    },
    "The retained SteamCMD candidate changed. Review it again before approving." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The retained SteamCMD candidate changed. Review it again before approving."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "保留的 SteamCMD 候选文件已改变。请重新核对后再确认授权。"}}}
    },
    "All Wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "All Wallpapers"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "全部壁纸"}}}
    },
    "The downloaded candidate is kept here for approval and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The downloaded candidate is kept here for approval and retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的候选文件保留在此处，供确认放行后重试。"}}}
    },
    "Show Downloaded File" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Show Downloaded File"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "显示已下载文件"}}}
    },
    "Allow This SteamCMD…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allow This SteamCMD…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅允许这份 SteamCMD…"}}}
    },
    "Discard Download…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Discard Download…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃下载…"}}}
    },
    "Continue Installation" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Continue Installation"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续安装"}}}
    },
    "Allow this SteamCMD installation?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allow this SteamCMD installation?"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "是否仅允许这份 SteamCMD？"}}}
    },
    "Allow This Copy and Continue" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Allow This Copy and Continue"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅允许此副本并继续"}}}
    },
    "This runs software macOS has not approved and may put your data at risk. Only the signed files matching this fingerprint will be allowed. Quarantine is removed from this copy only; global Gatekeeper and signature checks stay enabled. Changed files require another approval.\n\nPath: %@\nSHA-256: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This runs software macOS has not approved and may put your data at risk. Only the signed files matching this fingerprint will be allowed. Quarantine is removed from this copy only; global Gatekeeper and signature checks stay enabled. Changed files require another approval.\n\nPath: %@\nSHA-256: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此操作将运行未经 macOS 批准的软件，可能危及你的数据。仅允许与此指纹匹配且通过签名检查的文件。仅移除此副本的隔离标记，全局 Gatekeeper 和签名检查仍保持启用。文件发生变化后需要再次确认。\n\n路径：%@\nSHA-256：%@"}}}
    },
    "Discard this downloaded candidate?" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Discard this downloaded candidate?"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃这份已下载的候选文件？"}}}
    },
    "Discard Download" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Discard Download"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "丢弃下载"}}}
    },
    "Only the retained SteamCMD download will be removed. Your installed runtime, wallpapers, and saved Steam sign-in are kept." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Only the retained SteamCMD download will be removed. Your installed runtime, wallpapers, and saved Steam sign-in are kept."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "仅删除保留的 SteamCMD 下载文件。已安装的运行时、壁纸和已保存的 Steam 登录均会保留。"}}}
    },
    "Signature checks remain required. Allow This SteamCMD authorizes only the exact downloaded copy after confirmation; it never disables global Gatekeeper or re-signs code." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Signature checks remain required. Allow This SteamCMD authorizes only the exact downloaded copy after confirmation; it never disables global Gatekeeper or re-signs code."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "签名检查仍为必需。确认“仅允许这份 SteamCMD”只授权这一份下载副本，不会关闭全局 Gatekeeper 或重新签名代码。"}}}
    },
    "Library" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Library"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库"}}}
    },
    "Workshop" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Workshop"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创意工坊"}}}
    },
    "MacWallpaperEngine" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "MacWallpaperEngine"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "MacWallpaperEngine"}}}
    },
    "This wallpaper is no longer in your library. Refresh Library and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is no longer in your library. Refresh Library and retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此壁纸已不在壁纸库中。请刷新壁纸库后重试。"}}}
    },
    "A little life on your desktop." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A little life on your desktop."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "为桌面添一点生机。"}}}
    },
    "Playback" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Playback"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "播放"}}}
    },
    "Resume wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Resume wallpapers"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "继续播放壁纸"}}}
    },
    "Pause wallpapers" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Pause wallpapers"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "暂停壁纸"}}}
    },
    "Select a wallpaper" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Select a wallpaper"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸"}}}
    },
    "Select a Workshop wallpaper to see its details. Browsing does not change your desktop." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Select a Workshop wallpaper to see its details. Browsing does not change your desktop."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择创意工坊壁纸以查看详情。浏览不会更改桌面。"}}}
    },
    "Couldn’t complete that action" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Couldn’t complete that action"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法完成此操作"}}}
    },
    "Apply to" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Apply to"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用到"}}}
    },
    "Selected display unavailable" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Selected display unavailable"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所选显示器不可用"}}}
    },
    "Refresh Displays" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Refresh Displays"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "刷新显示器"}}}
    },
    "Refresh all wallpaper state before applying again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Refresh all wallpaper state before applying again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "再次应用前，请刷新所有壁纸状态。"}}}
    },
    "Choose an enabled independent display." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose an enabled independent display."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择已启用的独立显示器。"}}}
    },
    "Active on selected display" : {
