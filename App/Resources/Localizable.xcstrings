    },
    "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS could not complete its SteamCMD security assessment. Retry after resolving the system security error; an explicit approval cannot bypass an assessment failure."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 未能完成对 SteamCMD 的安全评估。请先解决系统安全错误再重试；手动批准无法跳过评估失败。"}}}
    },
    "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS has not approved SteamCMD at %@. Review and approve this SteamCMD copy, or follow Apple’s app security guidance, then Retry. System security settings have not been changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 尚未批准位于 %@ 的 SteamCMD。请检查并批准这份副本，或按照 Apple 的安全指引操作，然后重试。系统安全设置没有被修改。"}}}
    },
    "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The SteamCMD approval candidate or private approval record changed or is unsafe. Review the current copy again; no approval was saved."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "待批准的 SteamCMD 或批准记录已变化或不安全，本次没有保存批准。请重新检查当前副本。"}}}
    },
    "The retained SteamCMD candidate changed. Review it again before approving." : {
