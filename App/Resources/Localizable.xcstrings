    },
    "Not enabled — action required" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Not enabled — action required"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "未启用，需要处理"}}}
    },
    "Restoration failed — quit cancelled" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Restoration failed — quit cancelled"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复失败，已取消退出"}}}
    },
    "An active wallpaper display is no longer connected. Refresh displays before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "An active wallpaper display is no longer connected. Refresh displays before retrying."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "一台正在播放壁纸的显示器已断开连接。请先刷新显示器再重试。"}}}
    },
    "Only committed video and live scene projects support Animate Lock Screen." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Only committed video and live scene projects support Animate Lock Screen."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "只有已应用的视频和动态场景壁纸支持“锁定屏幕动态壁纸”。"}}}
    },
    "The committed wallpaper does not declare a project type." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not declare a project type."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有声明项目类型。"}}}
    },
    "The committed wallpaper does not reference project.json." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper does not reference project.json."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸没有引用 project.json。"}}}
    },
    "The committed wallpaper contains a non-absolute source path." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The committed wallpaper contains a non-absolute source path."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已应用的壁纸包含非绝对路径的来源。"}}}
    },
    "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS did not load the lock-screen renderer. The original wallpaper has been restored. Check for another wallpaper app or a conflicting system-wide wallpaper selection."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 没有加载锁定屏幕渲染器，已恢复原来的墙纸。请检查是否有其他墙纸应用，或冲突的全局墙纸设置。"}}}
    },
    "Wallpaper assets changed while preparing the lock screen. Retry after the download or edit finishes." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper assets changed while preparing the lock screen. Retry after the download or edit finishes."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "准备锁定屏幕时壁纸文件发生了变化。请等下载或编辑完成后重试。"}}}
    },
    "Cannot create lock-screen asset: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot create lock-screen asset: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建锁定屏幕文件：%@"}}}
    },
    "Lock-screen assets cannot contain symbolic links or special files: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lock-screen assets cannot contain symbolic links or special files: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "锁定屏幕文件不能包含符号链接或特殊文件：%@"}}}
    },
    "Cannot enumerate wallpaper assets: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot enumerate wallpaper assets: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取壁纸文件列表：%@"}}}
    },
    "The wallpaper asset source must be a real directory: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper asset source must be a real directory: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸文件来源必须是真实的文件夹：%@"}}}
    },
    "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid Workshop wallpaper. Application wallpapers execute Windows programs and cannot be used on macOS."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择有效的创意工坊壁纸。应用程序类壁纸需要运行 Windows 程序，无法在 macOS 上使用。"}}}
    },
    "Downloaded, but the library could not refresh: %@. Refresh the library before applying it." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded, but the library could not refresh: %@. Refresh the library before applying it."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已下载，但壁纸库未能刷新：%@。请先刷新壁纸库再应用。"}}}
    },
    "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Enter your Steam account login name (not your display name). An account that owns Wallpaper Engine is required."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请输入 Steam 账户的登录名（不是昵称）。需要拥有 Wallpaper Engine 的账户。"}}}
    },
    "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD timed out. If Steam Guard was not completed, retry signing in and approve the new request or enter a fresh code. Otherwise check your connection and available disk space."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 超时。如果 Steam 令牌验证没有完成，请重新登录并批准新的请求或输入新的验证码；否则请检查网络连接和磁盘空间。"}}}
    },
    "Steam closed the session without confirming the sign-in. Check the account name and password, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam closed the session without confirming the sign-in. Check the account name and password, then retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 未确认登录就关闭了会话。请检查账户名和密码后重试。"}}}
    },
    "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Wallpaper Engine installation. Retry installing scene assets; existing assets have not been changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认 Wallpaper Engine 已完整安装。请重新安装场景资源，现有资源没有被改动。"}}}
    },
    "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam exited without confirming a complete Workshop download. Retry; no partial wallpaper has been added to your library."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 退出时没有确认创意工坊下载已完成。请重试，未完成的壁纸不会加入壁纸库。"}}}
    },
    "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry. On Apple silicon, SteamCMD may require Rosetta 2." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before confirming the sign-in. Check the account name and password, approve Steam Guard, and retry. On Apple silicon, SteamCMD may require Rosetta 2."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在确认登录前就退出了。请检查账户名和密码，批准 Steam 令牌验证后重试。在 Apple 芯片的 Mac 上，SteamCMD 可能需要 Rosetta 2。"}}}
    },
    "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry. On Apple silicon, SteamCMD may require Rosetta 2." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD exited before completing the download. Confirm this account owns Wallpaper Engine, approve Steam Guard, and retry. On Apple silicon, SteamCMD may require Rosetta 2."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 在下载完成前就退出了。请确认此账户拥有 Wallpaper Engine，批准 Steam 令牌验证后重试。在 Apple 芯片的 Mac 上，SteamCMD 可能需要 Rosetta 2。"}}}
    },
    "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not read SteamCMD’s private terminal without blocking. Restart WallpaperMachine and retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法读取 SteamCMD 的终端输出。请重新打开 WallpaperMachine 后重试。"}}}
    },
    "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create a private terminal for SteamCMD. Restart WallpaperMachine and retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法为 SteamCMD 创建终端。请重新打开 WallpaperMachine 后重试。"}}}
    },
    "Cannot launch SteamCMD: %@. Install the macOS SteamCMD distribution; on Apple silicon install Rosetta 2 if requested." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Cannot launch SteamCMD: %@. Install the macOS SteamCMD distribution; on Apple silicon install Rosetta 2 if requested."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法启动 SteamCMD：%@。请安装 macOS 版 SteamCMD；在 Apple 芯片的 Mac 上，如有提示请安装 Rosetta 2。"}}}
    },
    "Lost the connection to SteamCMD’s login terminal. Retry signing in." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Lost the connection to SteamCMD’s login terminal. Retry signing in."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "与 SteamCMD 登录终端的连接已断开。请重新登录。"}}}
    },
    "SteamCMD closed its login prompt. Retry signing in to start a new session." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD closed its login prompt. Retry signing in to start a new session."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "SteamCMD 关闭了登录提示。请重新登录以开始新的会话。"}}}
    },
    "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam ended this session because the account signed in somewhere else. Retry once the other sign-in is done."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在其他地方登录，Steam 结束了本次会话。等另一处登录结束后再重试。"}}}
    },
    "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam denied this download. Sign in with an account that owns Wallpaper Engine and has access to this Workshop item."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了此次下载。请使用拥有 Wallpaper Engine 且可以访问此创意工坊项目的账户登录。"}}}
    },
    "Steam could not download this item. It may be private, removed, or unavailable to this account. Open its Workshop page and retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not download this item. It may be private, removed, or unavailable to this account. Open its Workshop page and retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法下载此项目，它可能已设为私密、已被删除，或此账户无法访问。请打开它的创意工坊页面查看后重试。"}}}
    },
    "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not install Wallpaper Engine’s shared assets. Confirm ownership and check available disk space, then retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 无法安装 Wallpaper Engine 的共享资源。请确认账户拥有 Wallpaper Engine 并检查磁盘空间后重试。"}}}
    },
    "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Your saved Steam sign-in has expired or was revoked. Try again and sign in to Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已保存的 Steam 登录已过期或被撤销。请重试并重新登录 Steam。"}}}
    },
    "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard was rejected, cancelled or expired. Try again, enter your password, then approve the new request or use a new code."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 令牌验证被拒绝、已取消或已过期。请重试，输入密码后批准新的请求或使用新的验证码。"}}}
    },
    "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam could not complete the connection or sign-in in time. Check your connection and any Steam Guard approval, then retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没能及时完成连接或登录。请检查网络连接和 Steam 令牌验证后重试。"}}}
    },
    "Steam has temporarily limited sign-in attempts. Wait before retrying." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam has temporarily limited sign-in attempts. Wait before retrying."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 暂时限制了登录尝试，请稍后再试。"}}}
    },
    "Steam rejected the sign-in. Check your account login name, password, and Steam Guard approval, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam rejected the sign-in. Check your account login name, password, and Steam Guard approval, then retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了登录。请检查登录名、密码和 Steam 令牌验证后重试。"}}}
    },
    "Steam rejected the sign-in. Check your account login name and password, then retry." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam rejected the sign-in. Check your account login name and password, then retry."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 拒绝了登录。请检查登录名和密码后重试。"}}}
    },
    "Steam allows one session at a time for this account; waiting to retry" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam allows one session at a time for this account; waiting to retry"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此账户在 Steam 上同时只能有一个会话，正在等待重试"}}}
    },
    "Waiting for a free download slot" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for a free download slot"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待空闲的下载名额"}}}
    },
    "Waiting for the current sign-in to finish" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the current sign-in to finish"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待当前登录完成"}}}
    },
    "Waiting for the previous download" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for the previous download"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "正在等待上一项下载"}}}
    },
    "Wait for active and queued downloads to finish before changing saved sign-in settings." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wait for active and queued downloads to finish before changing saved sign-in settings."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请等进行中和排队的下载完成后，再更改已保存的登录设置。"}}}
    },
    "No system media provider is configured." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No system media provider is configured."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有可用的系统媒体来源。"}}}
    },
    "Choose a video, HTML file, or Wallpaper Engine project folder. Standalone images are not supported by this renderer." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a video, HTML file, or Wallpaper Engine project folder. Standalone images are not supported by this renderer."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择视频、HTML 文件或 Wallpaper Engine 项目文件夹。不支持单独的图片。"}}}
    },
    "The folder name cannot be used as a library identifier." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The folder name cannot be used as a library identifier."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹名称无法用作壁纸库标识符。"}}}
    },
    "Choose a source outside WallpaperMachine’s managed library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a source outside WallpaperMachine’s managed library."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择 WallpaperMachine 壁纸库以外的来源。"}}}
    },
    "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not publish Workshop item %@: %@. Download staging and the library must be on the same volume."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法添加创意工坊项目 %1$@：%2$@。下载的临时目录和壁纸库必须在同一个磁盘卷上。"}}}
    },
    "Download staging must be outside the managed library." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Download staging must be outside the managed library."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的临时目录必须位于壁纸库之外。"}}}
    },
    "Choose a valid numeric Workshop item identifier." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a valid numeric Workshop item identifier."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请使用有效的数字创意工坊项目 ID。"}}}
    },
    "Download directories must be real folders, not symbolic links or special files: %@." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Download directories must be real folders, not symbolic links or special files: %@."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载目录必须是真实的文件夹，不能是符号链接或特殊文件：%@。"}}}
    },
    "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Downloaded projects may contain only regular files and folders, not symbolic links or special files: %@."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "下载的项目只能包含普通文件和文件夹，不能包含符号链接或特殊文件：%@。"}}}
    },
    "No project.json found. Choose a wallpaper project, a folder containing projects, or a Steam library with steamapps/workshop/content/431960." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No project.json found. Choose a wallpaper project, a folder containing projects, or a Steam library with steamapps/workshop/content/431960."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "找不到 project.json。请选择壁纸项目、包含项目的文件夹，或带有 steamapps/workshop/content/431960 的 Steam 库。"}}}
    },
    "Symbolic links are not imported. Choose the original folder or file instead." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported. Choose the original folder or file instead."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接。请选择原始文件夹或文件。"}}}
    },
    "The project’s file field must be a relative filename." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must be a relative filename."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须是相对文件名。"}}}
    },
    "The preview path must remain inside the wallpaper folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The preview path must remain inside the wallpaper folder."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "预览图路径必须位于壁纸文件夹内。"}}}
    },
    "Project dependency paths may not escape their folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Project dependency paths may not escape their folder."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目依赖路径不能指向其文件夹之外。"}}}
    },
    "Missing project content: %@. Copy the complete wallpaper folder, not just project.json." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Missing project content: %@. Copy the complete wallpaper folder, not just project.json."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "缺少项目内容：%@。请复制完整的壁纸文件夹，而不只是 project.json。"}}}
    },
    "The project’s file field must point inside its own folder (no absolute paths or parent traversal)." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The project’s file field must point inside its own folder (no absolute paths or parent traversal)."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "项目的 file 字段必须指向自身文件夹内的文件（不能用绝对路径或上级目录）。"}}}
    },
    "project.json must describe a scene, video, or web wallpaper." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must describe a scene, video, or web wallpaper."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须描述场景、视频或网页壁纸。"}}}
    },
    "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must use UTF-8 encoding without a byte-order mark. Convert the manifest and import it again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须使用不带 BOM 的 UTF-8 编码。请转换后重新导入。"}}}
    },
    "project.json must be a regular JSON file smaller than 16 MB." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "project.json must be a regular JSON file smaller than 16 MB."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "project.json 必须是小于 16 MB 的普通 JSON 文件。"}}}
    },
    "Could not create %@. Check available disk space and folder permissions." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Could not create %@. Check available disk space and folder permissions."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法创建 %@。请检查磁盘空间和文件夹权限。"}}}
    },
    "Unsupported special file: %@. Only regular files and folders can be imported." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unsupported special file: %@. Only regular files and folders can be imported."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持的特殊文件：%@。只能导入普通文件和文件夹。"}}}
    },
    "Symbolic links are not imported: %@. Copy the original content into the project folder first." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Symbolic links are not imported: %@. Copy the original content into the project folder first."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不导入符号链接：%@。请先把原始内容复制到项目文件夹中。"}}}
    },
    "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "macOS refused to reload the user-owned wallpaper service (errno %d). The restoration journal was retained."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "macOS 拒绝重新加载墙纸服务（errno %d）。恢复记录已保留。"}}}
    },
    "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "No positively verified user-owned WallpaperAgent is running. Native selection could not be activated; its restoration journal was retained."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "没有找到可确认属于当前用户的 WallpaperAgent 进程，无法启用锁定屏幕墙纸。恢复记录已保留。"}}}
    },
    "Unable to identify the wallpaper service safely." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to identify the wallpaper service safely."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法安全识别墙纸服务。"}}}
    },
    "Unable to enumerate the wallpaper service." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unable to enumerate the wallpaper service."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "无法列出墙纸服务进程。"}}}
    },
    "This macOS Space has an unsupported wallpaper configuration." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS Space has an unsupported wallpaper configuration."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这个 macOS 桌面空间的墙纸配置不受支持。"}}}
    },
    "The system wallpaper was changed outside WallpaperMachine. Disable Animate Lock Screen before enabling it again; external choices will be preserved." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper was changed outside WallpaperMachine. Disable Animate Lock Screen before enabling it again; external choices will be preserved."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "系统墙纸在 WallpaperMachine 之外被更改了。请先关闭再重新开启“锁定屏幕动态壁纸”，你在别处做的选择会保留。"}}}
    },
    "The native wallpaper restoration journal is invalid." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The native wallpaper restoration journal is invalid."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸恢复记录无效。"}}}
    },
    "A native wallpaper override was removed outside WallpaperMachine. Disable Animate Lock Screen before enabling it again." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper override was removed outside WallpaperMachine. Disable Animate Lock Screen before enabling it again."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "墙纸设置在 WallpaperMachine 之外被移除了。请先关闭再重新开启“锁定屏幕动态壁纸”。"}}}
    },
    "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The system wallpaper changed during native selection. Please retry; no concurrent changes were overwritten."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置过程中系统墙纸发生了变化。请重试，其间的更改没有被覆盖。"}}}
    },
    "This macOS wallpaper store format is unsupported. Native selection was not changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This macOS wallpaper store format is unsupported. Native selection was not changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不支持这个版本的 macOS 墙纸存储格式，墙纸设置没有被更改。"}}}
    },
    "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling Animate Lock Screen; the existing global wallpaper was not changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A system-wide linked wallpaper currently overrides individual displays. Turn off that wallpaper app or its all-displays setting before enabling Animate Lock Screen; the existing global wallpaper was not changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "当前有一个全局墙纸覆盖了所有显示器。请先关闭那个墙纸应用或它的“所有显示器”设置，再开启“锁定屏幕动态壁纸”。现有的全局墙纸没有被更改。"}}}
    },
    "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling Animate Lock Screen." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "A native wallpaper selection has no restoration journal or surviving system fallback. Choose a system wallpaper for this display before enabling Animate Lock Screen."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这台显示器的墙纸设置没有可用的恢复记录或系统备选。请先为它选择一张系统墙纸，再开启“锁定屏幕动态壁纸”。"}}}
    },
    "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is downloaded, but Wallpaper Engine’s shared scene resources are not installed. Choose Get shared resources in the wallpaper’s details, or go to Settings → Library & Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已下载，但还没有安装 Wallpaper Engine 的共享场景资源。请在壁纸详情中点击“获取共享资源”，或前往“设置 → 壁纸库与 Steam”。"}}}
    },
    "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This folder does not contain Wallpaper Engine’s shared shaders and materials. Choose its complete assets folder, or install scene assets through Steam."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "此文件夹不包含 Wallpaper Engine 的共享着色器和材质。请选择完整的 assets 文件夹，或通过 Steam 安装场景资源。"}}}
    },
    "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Steam did not produce complete scene assets. Confirm this account owns Wallpaper Engine and retry. Existing assets have not been changed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 没有提供完整的场景资源。请确认此账户拥有 Wallpaper Engine 后重试，现有资源没有被改动。"}}}
    },
    "Locate Wallpaper Engine assets" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Locate Wallpaper Engine assets"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择 Wallpaper Engine 资源文件夹"}}}
    },
    "Choose the assets folder inside your legitimate Wallpaper Engine installation. These shared resources are required by many scenes." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose the assets folder inside your legitimate Wallpaper Engine installation. These shared resources are required by many scenes."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "请选择你已购买的 Wallpaper Engine 安装目录中的 assets 文件夹。很多场景壁纸都需要这些共享资源。"}}}
    },
    "This wallpaper is not a folder in the managed library. Nothing was deleted." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This wallpaper is not a folder in the managed library. Nothing was deleted."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "这张壁纸不是壁纸库中的文件夹，没有删除任何内容。"}}}
    },
    "Invalid wallpaper ID. Nothing was deleted." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Invalid wallpaper ID. Nothing was deleted."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸 ID 无效，没有删除任何内容。"}}}
    },
    "Restoration also failed: %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Restoration also failed: %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "恢复也失败了：%@"}}}
    },
    "Unavailable" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Unavailable"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "不可用"}}}
