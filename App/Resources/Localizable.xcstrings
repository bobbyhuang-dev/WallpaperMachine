      }
    },
    "Steam Guard help" : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Steam Guard help"}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 令牌官方帮助"
          }
        }
      }
    },
    "Mobile approval: open the Steam mobile app, select the same account in the Steam Guard shield tab, and approve the request you just started. If no notification appears, open Steam Guard directly. Only approve a sign-in you recognize." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Mobile approval: open the Steam mobile app, select the same account in the Steam Guard shield tab, and approve the request you just started. If no notification appears, open Steam Guard directly. Only approve a sign-in you recognize."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机确认：打开 Steam 手机应用，在盾牌图标的 Steam 令牌页选择同一个账号，批准你刚发起的登录请求。没有收到通知时，直接打开令牌页查看。只批准你确认由自己发起的登录。"
          }
        }
      }
    },
    "Authenticator code: in the Steam mobile app, open Steam Guard for this account and show its current code. Enter it in the Steam Guard code field here and press Submit before it changes. Check that your phone’s date and time are set automatically if codes are rejected." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Authenticator code: in the Steam mobile app, open Steam Guard for this account and show its current code. Enter it in the Steam Guard code field here and press Submit before it changes. Check that your phone’s date and time are set automatically if codes are rejected."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机验证码：在 Steam 手机应用中打开此账号的 Steam 令牌，查看当前验证码，在本应用的 Steam Guard code 输入框填写，并在代码更新前点击 Submit。若验证码被拒绝，请检查手机是否已启用自动设置日期与时间。"
          }
        }
      }
    },
    "Email code: check the email address registered to this Steam account, including spam, then enter the latest Steam Guard code here and press Submit. Delivery can be delayed; if this login expires, use Retry Steam sign-in and use the new code." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Email code: check the email address registered to this Steam account, including spam, then enter the latest Steam Guard code here and press Submit. Delivery can be delayed; if this login expires, use Retry Steam sign-in and use the new code."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件验证码：检查此 Steam 账号绑定的邮箱及垃圾邮件，在此填写最新的 Steam 令牌验证码并点击 Submit。邮件可能延迟；若本次登录已过期，点击“重新发起 Steam 登录”，使用新请求的验证码。"
          }
        }
      }
    },
    "Do not disable Steam Guard or share passwords, codes, or recovery codes. If you denied this request or it expired, wait for this attempt to finish and choose Retry Steam sign-in. Steam decides which verification method is available; retrying does not bypass approval." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Do not disable Steam Guard or share passwords, codes, or recovery codes. If you denied this request or it expired, wait for this attempt to finish and choose Retry Steam sign-in. Steam decides which verification method is available; retrying does not bypass approval."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要关闭 Steam 令牌，也不要分享密码、验证码或恢复码。若误点拒绝或请求过期，等本次尝试结束后点击“重新发起 Steam 登录”。验证方式由 Steam 决定，重试不会绕过验证。"
          }
        }
      }
    },
    "Starts a new SteamCMD login using the account name above. If prompted, enter your password, then approve the new request or enter a fresh code. The rejected request is not reused. If Steam reports too many attempts, wait before retrying." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Starts a new SteamCMD login using the account name above. If prompted, enter your password, then approve the new request or enter a fresh code. The rejected request is not reused. If Steam reports too many attempts, wait before retrying."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用上方账号重新发起 SteamCMD 登录。如有提示，请输入密码，然后批准新的登录请求或填写新的验证码，不会复用被拒绝的请求。若 Steam 提示尝试过于频繁，请先等待再重试。"
          }
        }
      }
    },
    "Saved Steam sign-in for this account on this Mac" : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Saved Steam sign-in for this account on this Mac"}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账号的 Steam 登录缓存已保存在本机"
          }
        }
      }
    },
    "Keep me signed in on this Mac" : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Keep me signed in on this Mac"}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 Mac 上保持登录"
          }
        }
      }
    },
    "When enabled, Steam-issued sign-in cache is saved privately on this Mac, not your submitted password or Steam Guard codes. Downloads still use temporary staging. Steam may request a fresh login after expiry, revocation, or security checks." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "When enabled, Steam-issued sign-in cache is saved privately on this Mac, not your submitted password or Steam Guard codes. Downloads still use temporary staging. Steam may request a fresh login after expiry, revocation, or security checks."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Steam 签发的登录缓存会保存在这台 Mac 的私有目录中，不会保存你输入的密码或 Steam 令牌验证码。下载仍使用临时暂存目录。缓存过期、被撤销或触发安全检查时，Steam 可能要求重新登录。"
          }
        }
      }
    },
    "Forget saved Steam sign-in" : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Forget saved Steam sign-in"}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除已保存的 Steam 登录"
          }
        }
      }
    },
    "Removes saved sign-in from this Mac only; it does not sign out other Steam devices." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Removes saved sign-in from this Mac only; it does not sign out other Steam devices."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅清除此 Mac 上保存的登录，不会退出其他设备上的 Steam 登录。"
          }
        }
      }
    },
    "Saved sign-in warning" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录缓存警告"
          }
        }
      }
    },
    "MacWallpaperEngine runs a private copy of SteamCMD and removes temporary download staging. Keep me signed in on this Mac saves Steam-issued sign-in cache in private app support storage, never submitted passwords or Steam Guard codes. Turn it off or choose Forget saved Steam sign-in to remove the local cache; other Steam devices stay signed in. Steam can request fresh authentication after expiry, revocation, or security checks. Downloads can take longer on first launch while SteamCMD updates." : {
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "MacWallpaperEngine runs a private copy of SteamCMD and removes temporary download staging. Keep me signed in on this Mac saves Steam-issued sign-in cache in private app support storage, never submitted passwords or Steam Guard codes. Turn it off or choose Forget saved Steam sign-in to remove the local cache; other Steam devices stay signed in. Steam can request fresh authentication after expiry, revocation, or security checks. Downloads can take longer on first launch while SteamCMD updates."}},
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacWallpaperEngine 运行独立的 SteamCMD 副本，并清理临时下载目录。“在这台 Mac 上保持登录”会将 Steam 签发的登录缓存保存在私有的应用支持目录中，绝不保存你输入的密码或 Steam 令牌验证码。关闭此选项或选择“清除已保存的 Steam 登录”即可删除本地缓存，其他设备仍保持 Steam 登录。缓存过期、被撤销或触发安全检查时，Steam 可能要求重新验证。首次启动时 SteamCMD 需要更新，下载可能耗时更长。"
          }
        }
      }
    },
