    },
    "By %@" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "By %@"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "作者：%@"}}}
    },
    "Scene support is experimental. Some effects, scripts, and audio features may differ from Windows. Shared scene assets are installed separately from Workshop wallpapers." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Scene support is experimental. Some effects, scripts, and audio features may differ from Windows. Shared scene assets are installed separately from Workshop wallpapers."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景支持仍处于实验阶段。部分效果、脚本和音频功能可能与 Windows 不同。共享场景资源与创意工坊壁纸分开安装。"}}}
    },
    "View full description, creator, and requirements on Steam" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "View full description, creator, and requirements on Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在 Steam 上查看完整说明、作者和所需条件"}}}
    },
    "Available in your local library" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Available in your local library"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "已在本地壁纸库中"}}}
    },
    "Scene assets still need setup" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Scene assets still need setup"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景资源仍需设置"}}}
    },
    "The wallpaper download is complete. Install Wallpaper Engine’s shared resources once, or locate your purchased installation’s assets folder." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The wallpaper download is complete. Install Wallpaper Engine’s shared resources once, or locate your purchased installation’s assets folder."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸已下载完成。请安装一次 Wallpaper Engine 的共享资源，或选择你已购买版本安装目录中的 assets 文件夹。"}}}
    },
    "Install scene assets…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Install scene assets…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "安装场景资源…"}}}
    },
    "Show in Library" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Show in Library"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在壁纸库中显示"}}}
    },
    "Application wallpapers contain Windows executables. MacWallpaperEngine will not download or run them. Choose a Scene wallpaper instead." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Application wallpapers contain Windows executables. MacWallpaperEngine will not download or run them. Choose a Scene wallpaper instead."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用程序壁纸包含 Windows 可执行文件。MacWallpaperEngine 不会下载或运行它们。请选择场景壁纸。"}}}
    },
    "Set up scene assets" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Set up scene assets"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "设置场景资源"}}}
    },
    "Close this setup and apply your wallpaper. No restart or wallpaper re-download is needed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Close this setup and apply your wallpaper. No restart or wallpaper re-download is needed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "关闭此设置并应用壁纸即可，无需重启或重新下载壁纸。"}}}
    },
    "Workshop downloads do not include Wallpaper Engine’s shared shaders and materials. Install them with a Steam account that owns Wallpaper Engine, or use an existing installation." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Workshop downloads do not include Wallpaper Engine’s shared shaders and materials. Install them with a Steam account that owns Wallpaper Engine, or use an existing installation."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "创意工坊下载不包含 Wallpaper Engine 的共享着色器和材质。请使用拥有 Wallpaper Engine 的 Steam 账号安装这些资源，或使用已有安装。"}}}
    },
    "Locate assets…" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Locate assets…"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择资源位置…"}}}
    },
    "Connect to Steam Workshop" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Connect to Steam Workshop"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "连接 Steam 创意工坊"}}}
    },
    "Browsing is public and needs no API key. Downloads require Valve’s SteamCMD and a Steam account that legitimately owns Wallpaper Engine." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Browsing is public and needs no API key. Downloads require Valve’s SteamCMD and a Steam account that legitimately owns Wallpaper Engine."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "浏览公开内容无需 API 密钥。下载需要 Valve 的 SteamCMD，以及合法拥有 Wallpaper Engine 的 Steam 账号。"}}}
    },
    "Install SteamCMD here, or locate a complete existing macOS installation. Installation does not require a Steam login. On Apple silicon, follow Apple’s Rosetta instructions if setup reports that it is needed." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Install SteamCMD here, or locate a complete existing macOS installation. Installation does not require a Steam login. On Apple silicon, follow Apple’s Rosetta instructions if setup reports that it is needed."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "在此安装 SteamCMD，或选择已有的完整 macOS 安装。安装无需登录 Steam。在 Apple 芯片 Mac 上，如果安装程序提示需要 Rosetta，请遵循 Apple 的 Rosetta 指引。"}}}
    },
    "Choose a wallpaper, enter your Steam account login name, and confirm ownership on first use or when switching accounts. Enter your password or Steam Guard code only when prompted; mobile approval is supported." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Choose a wallpaper, enter your Steam account login name, and confirm ownership on first use or when switching accounts. Enter your password or Steam Guard code only when prompted; mobile approval is supported."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "选择壁纸，输入 Steam 账号登录名，并在首次使用或切换账号时确认拥有 Wallpaper Engine。仅在出现提示时输入密码或 Steam 令牌验证码；也支持手机确认。"}}}
    },
    "Wallpaper Engine on Steam" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper Engine on Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "Steam 上的 Wallpaper Engine"}}}
    },
    "Library & Steam" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Library & Steam"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库与 Steam"}}}
    },
    "Wallpaper library" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Wallpaper library"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "壁纸库"}}}
    },
    "Imports are copied into MacWallpaperEngine. Your original files and Steam library are left untouched." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Imports are copied into MacWallpaperEngine. Your original files and Steam library are left untouched."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "导入内容会复制到 MacWallpaperEngine。原始文件和 Steam 库保持不变。"}}}
    },
    "Scene wallpapers need shared resources in addition to the Workshop download. Install them once through Steam or choose your purchased installation’s assets folder. Videos do not require it. Scene support is experimental; some effects and scripts may differ from Windows." : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Scene wallpapers need shared resources in addition to the Workshop download. Install them once through Steam or choose your purchased installation’s assets folder. Videos do not require it. Scene support is experimental; some effects and scripts may differ from Windows."}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "场景壁纸除了创意工坊下载内容外，还需要共享资源。通过 Steam 安装一次，或选择你已购买版本安装目录中的 assets 文件夹即可。视频无需这些资源。场景支持仍处于实验阶段，部分效果和脚本可能与 Windows 不同。"}}}
    },
    "All types" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "All types"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "所有类型"}}}
    },
    "Application" : {
      "localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Application"}}, "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "应用程序"}}}
    },
    "Scene · experimental renderer" : {
