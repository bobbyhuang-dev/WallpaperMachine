{
  "sourceLanguage" : "en",
  "strings" : {
    "Could not forget the saved Steam sign-in: %@" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法忘记已保存的 Steam 登录：%@" } } }
    },
    "Could not update the saved Steam sign-in: %@. You may need to sign in again next time." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法更新已保存的 Steam 登录：%@。下次可能需要重新登录。" } } }
    },
    "Steam did not provide reusable sign-in files. You may need to sign in again next time." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Steam 未提供可复用的登录文件，下次可能需要重新登录。" } } }
    },
    "Saved Steam sign-in expired; waiting for fresh authentication…" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存的 Steam 登录已失效，等待重新验证…" } } }
    },
    "Your saved Steam sign-in has expired or was revoked. Choose Retry Steam sign-in and complete authentication again." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存的 Steam 登录已过期或被撤销。请点击“重新发起 Steam 登录”并完成验证。" } } }
    },
    "Using your saved Steam sign-in…" : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在使用已保存的 Steam 登录…" } } }
    },
    "Steam sign-in storage must be a private directory, not a symbolic link." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Steam 登录保存位置必须是私有目录，不能是符号链接。" } } }
    },
    "Steam sign-in files cannot be read through symbolic links." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不能通过符号链接读取 Steam 登录文件。" } } }
    },
    "Steam sign-in storage contains an unsafe file." : {
      "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Steam 登录保存目录包含不安全的文件。" } } }
    },
